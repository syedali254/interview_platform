# ── Secrets ──────────────────────────────────────────────────────────────
.env
*.env.local

# ── Python ───────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Node / frontend build output ─────────────────────────────────────────
node_modules/
InterviewAI/frontend/dist/
# Vision model assets are fetched at build time by fetch-vision-assets.mjs
InterviewAI/frontend/public/mediapipe/

# ── Runtime artefacts ────────────────────────────────────────────────────
*.log
InterviewAI/data/uploads/
InterviewAI/core/evaluator/models/*.joblib

# ── Generated figures ────────────────────────────────────────────────────
# Regenerated by report/diagrams.py and the evaluation harness. The measured
# results they are drawn from ARE tracked — see below.
report/figures/
InterviewAI/experiments/figures/

# ── Word lock files ──────────────────────────────────────────────────────
~$*

# ── Deliberately tracked, listed here so the intent is explicit ───────────
# InterviewAI/experiments/results/   raw scores and statistics — the evidence
#                                    behind Chapter 6, must be reproducible
# report/*.docx                      the submitted dissertation
# InterviewAI/data/esco/             ESCO taxonomy exports the graph is built on
