# InterviewAI — Environment Variables
# Copy this file to .env and fill in your API keys

# REQUIRED: Gemini — parsing, question generation and answer scoring
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# REQUIRED: Deepgram — speech-to-text, and the fallback interviewer voice
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OPTIONAL: ElevenLabs — preferred interviewer voice.
# If this key is missing, invalid, or out of credit, the agent detects it at
# startup and uses the Deepgram voice instead. The interview still runs.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: LiveKit (auto-configured for local dev)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: interview length. Lower these for a quick demo run.
MAX_INTERVIEW_QUESTIONS=15
MIN_INTERVIEW_QUESTIONS=5
INTERVIEW_TIME_BUDGET_MINS=30

# Optional: voice selection
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# Optional: turn-taking. The defaults suit an interview, where answers are
# long and contain pauses for thought. Change these only if the agent
# misbehaves on your machine.
#
#   Agent cuts you off before you have finished  -> raise the first three
#   Agent's own voice breaks up mid-question     -> raise the next two,
#                                                   and wear headphones
#
# STT_ENDPOINTING_MS=1100          silence (ms) that ends an utterance
# MIN_ENDPOINTING_DELAY=1.8        shortest wait (s) before the agent replies
# MAX_ENDPOINTING_DELAY=8.0        longest wait (s) before it replies anyway
# MIN_INTERRUPTION_DURATION=1.2    speech (s) needed to interrupt the agent
# MIN_INTERRUPTION_WORDS=4         words needed to interrupt the agent
# FALSE_INTERRUPTION_TIMEOUT=2.0   silence (s) after which it resumes talking
