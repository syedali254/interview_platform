# InterviewAI — Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Gemini (LLM for all AI features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Required: Deepgram (Speech-to-Text for voice interviews)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Required: ElevenLabs (Text-to-Speech for AI interviewer voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: LiveKit (auto-configured for local dev)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: Interview settings
MAX_INTERVIEW_QUESTIONS=15
MIN_INTERVIEW_QUESTIONS=5
INTERVIEW_TIME_BUDGET_MINS=30
